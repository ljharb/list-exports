{
	"name": "ex-exports-cjs",
	"version": "0.0.0",
	"engines": {
		"node": "*"
	},
	"problems": [
		"`.` has a `package.json`, but lacks both a `main` and an `index.js`!"
	],
	"exports": {
		"binaries": {},
		"latest": "pattern-trailers",
		"pattern-trailers": {
			"import": {
				".": "./main.cjs"
			},
			"require": {
				".": "./main.cjs"
			},
			"files": [
				"./main.cjs"
			],
			"tree": {
				"main.cjs": [
					"."
				]
			}
		},
		"pre-exports": {
			"import": {},
			"require": {
				"./main.cjs": "./main.cjs",
				"./package": "./package.json",
				"./package.json": "./package.json"
			},
			"files": [
				"./main.cjs",
				"./package.json"
			],
			"tree": {
				"main.cjs": [
					"./main.cjs"
				],
				"package.json": [
					"./package.json",
					"./package"
				]
			}
		}
	}
}
